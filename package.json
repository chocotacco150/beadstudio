{
  "name": "bead-studio",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "豆图 · 图片转拼豆图纸桌面工具",
  "author": "chocotacco150",
  "main": "desktop/main.cjs",
  "scripts": {
    "start:local": "node scripts/local-server.mjs --open",
    "dev": "node scripts/prepare-cutout-runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-cutout-runtime.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:desktop": "node --test desktop/policy.test.cjs desktop/server.test.cjs",
    "models:download": "node scripts/fetch-cutout-models.mjs --all",
    "models:verify": "node scripts/fetch-cutout-models.mjs --all --verify",
    "desktop:dev": "electron .",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "dependencies": {
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "onnxruntime-web": "1.24.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  }
}
